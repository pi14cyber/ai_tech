# Данные конкретного человека не попадают в публичную историю
workspace/*
!workspace/README.md
!workspace/LOCAL-ONLY.template

# Входящие файлы человека: личные данные, в публичную историю не попадают
inbox/*
!inbox/README.md

# Клоны чужих репозиториев для разбора практик: в публичную историю не попадают
kit/internal/research/

# Прогоны методики: песочницы с данными, в публичную историю не попадают
runs/

# Каталоги оболочек: адаптеры навыков — только ссылки, в публичную историю не попадают
.dsh/
.claude/skills/
.agents/skills/

# Временные копии для проверок и самотестов: в историю не попадают
kit/internal/draft/**/tmp-*/
kit/internal/draft/_selftest*/
kit/scripts/_selftest*/

# Служебное
.DS_Store
*.log
node_modules/
.env
__pycache__/
*.pyc
